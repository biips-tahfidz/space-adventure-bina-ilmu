{
  "version": 2,
  "name": "petualangan-luar-angkasa-bina-ilmu",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "autoplay=(self)" }
      ]
    }
  ]
}
